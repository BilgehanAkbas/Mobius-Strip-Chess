# Online oyun için Supabase bağlantısı. Bu dosyayı .env.local olarak kopyalayıp doldur,
# aynı iki değeri Vercel'de Environment Variables bölümüne de ekle.
# Yalnızca Project URL ve publishable/anon key yazılır. service_role ya da secret key ASLA yazılmaz.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
